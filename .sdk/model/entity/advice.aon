# Entity: advice

main: kit: entity: advice: {

  alias: field: {}

  fields: [
    {
      name: "advice"
      req: false
      short: "The advice text"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the advice slip"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "advice"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "slip_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/advice/{slip_id}"
          rename: {
            param: {
              slip_id: "id"
            }
          }
          segments: [
            {
              lit: "advice"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.slip`"
          }
        }
        {
          method: "GET"
          orig: "/advice"
          segments: [
            {
              lit: "advice"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.slip`"
          }
        }
      ]
    }
  }



}
